* text=auto

# Source stays text
*.cs text
*.cpp text
*.h text
*.ini text
*.uproject text
*.uplugin text
*.json text
*.csv text
*.md text

# Unreal binary assets
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text

